{
  "name": "ponpoko-review",
  "displayName": "ponpoko-review",
  "description": "ブランチ間diffをツリー表示し、PRレビュー風インラインコメントをworktree単位でMarkdownに出力する個人用拡張",
  "version": "0.0.1",
  "publisher": "yannsugi",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "git CLI を実行するため、信頼済みワークスペースでのみ動作します。"
    }
  },
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "ponpoko-review",
      "properties": {
        "ponpokoReview.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "比較基準ブランチ（base...HEAD の base）。"
        },
        "ponpokoReview.outputDir": {
          "type": "string",
          "default": ".ponpoko-review",
          "description": "レビューmdの出力先ディレクトリ。相対パスはワークスペースルート基準、絶対パスも可。配下に <worktree名>/review.md を書き出す。"
        },
        "ponpokoReview.reviewCommand": {
          "type": "string",
          "default": "claude -p",
          "description": "Submit & Run で md を渡すコマンド。`cat <review.md> | <このコマンド>` として統合ターミナルで実行する。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ponpokoReview",
          "title": "ponpoko-review",
          "icon": "media/ponpoko-icon.svg"
        }
      ]
    },
    "views": {
      "ponpokoReview": [
        {
          "id": "ponpokoReview.diffTree",
          "name": "Diff Tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ponpokoReview.diffTree",
        "contents": "Git リポジトリが見つからないか、worktree がありません。\nGit リポジトリのフォルダを開いてください。"
      }
    ],
    "commands": [
      {
        "command": "ponpokoReview.refresh",
        "title": "ponpoko-review: ツリーを更新",
        "icon": "$(refresh)"
      },
      {
        "command": "ponpokoReview.gotoComment",
        "title": "ponpoko-review: コメントへ移動",
        "icon": "$(comment)"
      },
      {
        "command": "ponpokoReview.submitAndRun",
        "title": "ponpoko-review: 書き出して claude -p に流す (Submit & Run)",
        "icon": "$(run-all)"
      },
      {
        "command": "ponpokoReview.submit",
        "title": "ponpoko-review: レビューを書き出す (Submit)",
        "icon": "$(check)"
      },
      {
        "command": "ponpokoReview.clear",
        "title": "ponpoko-review: コメントを全消去 (Clear)",
        "icon": "$(clear-all)"
      },
      {
        "command": "ponpokoReview.addComment",
        "title": "ponpoko-review: コメントを追加"
      },
      {
        "command": "ponpokoReview.editComment",
        "title": "編集",
        "icon": "$(edit)"
      },
      {
        "command": "ponpokoReview.saveComment",
        "title": "保存"
      },
      {
        "command": "ponpokoReview.cancelComment",
        "title": "キャンセル"
      },
      {
        "command": "ponpokoReview.deleteComment",
        "title": "削除",
        "icon": "$(trash)"
      },
      {
        "command": "ponpokoReview.toggleResolve",
        "title": "Resolve / Unresolve",
        "icon": "$(pass)"
      },
      {
        "command": "ponpokoReview.setBase",
        "title": "ponpoko-review: 既定の比較先(base)を選択"
      },
      {
        "command": "ponpokoReview.setOutputDir",
        "title": "ponpoko-review: 出力先ディレクトリを設定"
      },
      {
        "command": "ponpokoReview.settings",
        "title": "ponpoko-review: 設定",
        "icon": "$(gear)"
      },
      {
        "command": "ponpokoReview.viewAsTree",
        "title": "ponpoko-review: ツリー表示にする",
        "icon": "$(list-tree)"
      },
      {
        "command": "ponpokoReview.viewAsList",
        "title": "ponpoko-review: リスト表示にする",
        "icon": "$(list-flat)"
      },
      {
        "command": "ponpokoReview.cycleViewMode",
        "title": "ponpoko-review: 表示モードを切り替え (list/tree)",
        "icon": "$(list-tree)"
      },
      {
        "command": "ponpokoReview.commentsFilterOn",
        "title": "ponpoko-review: コメントのあるファイルだけ表示",
        "icon": "$(filter)"
      },
      {
        "command": "ponpokoReview.commentsFilterOff",
        "title": "ponpoko-review: コメント絞り込みを解除",
        "icon": "$(filter-filled)"
      },
      {
        "command": "ponpokoReview.hideComments",
        "title": "ponpoko-review: ファイル配下のコメントを畳む",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ponpokoReview.showComments",
        "title": "ponpoko-review: ファイル配下のコメントを展開可能に",
        "icon": "$(comment)"
      },
      {
        "command": "ponpokoReview.submitWorktree",
        "title": "ponpoko-review: このworktreeのコメントを書き出す",
        "icon": "$(check)"
      },
      {
        "command": "ponpokoReview.clearWorktree",
        "title": "ponpoko-review: このworktreeのコメントをクリア",
        "icon": "$(clear-all)"
      },
      {
        "command": "ponpokoReview.setWorktreeBase",
        "title": "ponpoko-review: このworktreeの比較先(target)を設定",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ponpokoReview.cycleViewMode",
          "when": "view == ponpokoReview.diffTree",
          "group": "navigation@0"
        },
        {
          "command": "ponpokoReview.commentsFilterOn",
          "when": "view == ponpokoReview.diffTree && !ponpokoReview.commentsOnly",
          "group": "navigation@1"
        },
        {
          "command": "ponpokoReview.commentsFilterOff",
          "when": "view == ponpokoReview.diffTree && ponpokoReview.commentsOnly",
          "group": "navigation@1"
        },
        {
          "command": "ponpokoReview.hideComments",
          "when": "view == ponpokoReview.diffTree && ponpokoReview.showComments",
          "group": "navigation@1"
        },
        {
          "command": "ponpokoReview.showComments",
          "when": "view == ponpokoReview.diffTree && !ponpokoReview.showComments",
          "group": "navigation@1"
        },
        {
          "command": "ponpokoReview.settings",
          "when": "view == ponpokoReview.diffTree",
          "group": "navigation@9"
        },
        {
          "command": "ponpokoReview.refresh",
          "when": "view == ponpokoReview.diffTree",
          "group": "navigation@3"
        },
        {
          "command": "ponpokoReview.submit",
          "when": "view == ponpokoReview.diffTree",
          "group": "navigation@4"
        },
        {
          "command": "ponpokoReview.submitAndRun",
          "when": "view == ponpokoReview.diffTree",
          "group": "navigation@4.5"
        },
        {
          "command": "ponpokoReview.clear",
          "when": "view == ponpokoReview.diffTree",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "ponpokoReview.setWorktreeBase",
          "when": "view == ponpokoReview.diffTree && viewItem == ponpoko.worktree",
          "group": "inline@0"
        },
        {
          "command": "ponpokoReview.submitWorktree",
          "when": "view == ponpokoReview.diffTree && viewItem == ponpoko.worktree",
          "group": "inline@1"
        },
        {
          "command": "ponpokoReview.clearWorktree",
          "when": "view == ponpokoReview.diffTree && viewItem == ponpoko.worktree",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "ponpokoReview.addComment",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "ponpokoReview.toggleResolve",
          "when": "commentController == ponpokoReview",
          "group": "inline@1"
        }
      ],
      "comments/comment/title": [
        {
          "command": "ponpokoReview.editComment",
          "when": "commentController == ponpokoReview && comment == canEdit",
          "group": "group@1"
        },
        {
          "command": "ponpokoReview.deleteComment",
          "when": "commentController == ponpokoReview && comment == canEdit",
          "group": "group@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "ponpokoReview.saveComment",
          "when": "commentController == ponpokoReview && comment == canEdit",
          "group": "inline@1"
        },
        {
          "command": "ponpokoReview.cancelComment",
          "when": "commentController == ponpokoReview && comment == canEdit",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
